    <symbol id="logo" viewBox="0 0 28 28">
      <rect width="28" height="28" rx="8" fill="url(#brand-grad)" />
      <path d="M18.6 9.4A6.5 6.5 0 1 0 18.6 18.6" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" />
