{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodatOS",
  "identifier": "dev.codatos.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../../ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../../ui"
    }
  },
  "app": {
    "windows": [
      {
        "title": "CodatOS",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://127.0.0.1:47800 http://127.0.0.1:47800",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}